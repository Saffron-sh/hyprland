{
  "height": "",
  "width": "",
  "spacing": 6,
  "position":"bottom",
  
  "modules-left":["network","clock"],
  "modules-center":["hyprland/workspaces"],
  "modules-right":["cpu","memory","pulseaudio"],

  "network": {
	 "interval": 5,
	 "format-wifi": "{icon}{bandwidthDownBytes}",
	 "format-ethernet":"󰈀 {ipaddr} @  {bandwidthDownBytes}",
	 "format-disconnected":"󰌺 ",
	 "format-icons":["󰤯 ","󰤟 ","󰤢 ","󰤥 "," "],
	 "tooltip-format":"Interface:{ifname} at {signalStrength}%\nIP:{ipaddr}/{cidr}\nSSID:{essid}\nGateway:{gwaddr}"
  },

  "clock":{
  	"format":"| {:%R | %a %b %d, %Y}",
	"tooltip-format":"{:%c}"
  },

  "hyprland/workspaces": {
	"format": "{icon}",
	"format-icons": {
		"1": "I",
		"2": "II",
		"3": "III",
		"4": "IV",
		"5": "V",
        "6": "VI",
        "7": "VII",
        "8": "VIII",
        "9": "IX",
        "10":"X"
        }
  },

  "cpu":{
  	"format":" {usage}%",
    "onclick":"btop"
  },

  "memory": {
  	"interval": 30,
	"format":"|   {percentage}%",
    "tooltip-format":"Used {used}GiB / {total}GiB",
	"max-length": 10
  },

  "pulseaudio": {
	"format": "| {icon} {volume}%",
	"format-bluetooth": " {volume}%",
	"format-muted": "󰖁 ",
	"format-icons": ["󰖁 ","󰖀 ","󰕾 "],
	"scroll-step": 1,
	"on-click": "pavucontrol"
  }

}
